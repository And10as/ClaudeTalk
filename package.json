{
  "name": "claudetalk",
  "private": true,
  "version": "0.0.1",
  "description": "Local voice chat with Claude — MCP-first architecture, swappable local/cloud STT and TTS.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @claudetalk/app dev",
    "dev:mcp": "pnpm --filter @claudetalk/voice-mcp-server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "inspect:mcp": "pnpm --filter @claudetalk/voice-mcp-server inspect"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "protobufjs",
      "smart-whisper"
    ]
  }
}
